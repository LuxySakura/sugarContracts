# Admin deployer private key without 0x prefix or with 0x prefix, both are commonly accepted.
PRIVATE_KEY_ADMIN=your_private_key

# Optional Ethereum Sepolia settings.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=your_sepolia_private_key

# Base Sepolia RPC endpoint.
# You can use the public endpoint below or replace it with Alchemy/QuickNode/Infura.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base mainnet RPC endpoint.
# Replace with your provider URL if you want better reliability/rate limits.
BASE_RPC_URL=https://mainnet.base.org

# Basescan API key used by hardhat-verify.
BASESCAN_API_KEY=your_basescan_api_key

# Deployed contract addresses for testnet interaction scripts.
SUGAR_ORACLE_ADDRESS=0xYourSugarPriceOracleAddress
SUGAR_TOKEN_ADDRESS=0xYourSugarTokenAddress
SUGAR_USDC_ADDRESS=0xYourBaseSepoliaUsdcAddress

# Oracle update script input: USD price per ton.
# Example: 600 means 600 USD / ton.
SUGAR_USD_PRICE_PER_TON=600

# Test flow script inputs.
# Example token amount: 100 means buy 100 SUGAR.
TEST_USD_SPEND=0.1
TEST_USDC_SPEND=
TEST_TOKEN_BUY_AMOUNT=
TEST_REDEEM_AMOUNT=0.01
TEST_CAPACITY=1000000
RUN_USDC_FLOW=true
RUN_ETH_FLOW=true
RUN_REDEEM=true
RUN_WITHDRAWALS=false

# Withdrawal script config.
WITHDRAW_ETH=true
WITHDRAW_USDC=true
WITHDRAW_TO=0xYourTreasuryAddress
