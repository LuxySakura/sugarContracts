{
  SugarTokenModule: {
    // Fill this with the deployed SugarPriceOracle address on Base mainnet.
    oracleAddress: "0xYourDeployedSugarPriceOracleAddress",

    // Fill this with the official USDC token address on Base mainnet.
    usdcAddress: "0xYourBaseUsdcAddress",

    // Fill this with the official USDT token address on Base mainnet.
    usdtAddress: "0xYourBaseUsdtAddress",

    // Example: 1000 SUGAR = 1 ton.
    tokensPerTon: "1000n",
  },
}
