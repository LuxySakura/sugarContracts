{
  "name": "sugar-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "hardhat build",
    "clean": "hardhat clean",
    "compile": "hardhat build",
    "test": "hardhat test",
    "node": "hardhat node",
    "ignition:deploy:local:sugar": "hardhat ignition deploy ignition/modules/SugarCoin.ts",
    "ignition:deploy:local:presale": "hardhat ignition deploy ignition/modules/Presale.ts",
    "ignition:deploy:base-sepolia:sugar-oracle": "hardhat ignition deploy ignition/modules/SugarPriceOracle.ts --network baseSepolia --parameters ignition/parameters/sugar-price-oracle.base-sepolia.json5",
    "ignition:deploy:base-sepolia:sugar-token": "hardhat ignition deploy ignition/modules/SugarToken.ts --network baseSepolia --parameters ignition/parameters/sugar-token.base-sepolia.json5",
    "ignition:deploy:base:sugar-coin": "hardhat ignition deploy ignition/modules/SugarCoin.ts --network base --parameters ignition/parameters/sugar-coin.base.json5 --deployment-id sugar-coin-base-v2",
    "ignition:deploy:base:sugar-oracle": "hardhat ignition deploy ignition/modules/SugarPriceOracle.ts --network base --parameters ignition/parameters/sugar-price-oracle.base.json5",
    "ignition:deploy:base:sugar-token": "hardhat ignition deploy ignition/modules/SugarToken.ts --network base --parameters ignition/parameters/sugar-token.base.json5",
    "ignition:verify:base:sugar-oracle": "hardhat ignition verify --network base sugar-price-oracle-base-v1",
    "sugar:oracle:update:base-sepolia": "hardhat run scripts/updateSugarOracle.ts --network baseSepolia",
    "sugar:oracle:set-max-age:testnet": "hardhat run scripts/setMaxSugarPriceAge.ts --network baseSepolia",
    "sugar:oracle:set-max-age:base-sepolia": "hardhat run scripts/setMaxSugarPriceAge.ts --network baseSepolia",
    "sugar:oracle:set-max-age:base": "hardhat run scripts/setMaxSugarPriceAge.ts --network base",
    "sugar:token:deploy:base-sepolia": "hardhat run scripts/deploySugarTokenBaseSepolia.ts --network baseSepolia",
    "sugar:token:verify:base-sepolia": "node scripts/verifySugarTokenBaseSepolia.cjs",
    "sugar:testflow:base-sepolia": "hardhat run scripts/testSugarContracts.ts --network baseSepolia",
    "sugar:withdraw:base-sepolia": "hardhat run scripts/withdrawSugarFunds.ts --network baseSepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.0",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.4",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.12",
    "@nomicfoundation/hardhat-verify": "^3.0.12",
    "@nomicfoundation/hardhat-viem": "^3.0.4",
    "@nomicfoundation/hardhat-viem-assertions": "^3.0.7",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.1",
    "@types/node": "^22.8.5",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "dotenv": "^17.3.1",
    "hardhat": "^3.2.0",
    "typescript": "~5.8.0"
  }
}
